---
const engines = [
  {
    n: '01',
    title: 'BRIEF ENGINE',
    body: 'Daily command briefing. Readiness score, decision window, performance levers, carry-forward items. Under 200 words. Every morning at 7am.',
    color: '#FFDC00',
  },
  {
    n: '02',
    title: 'DECISION ENGINE',
    body: 'Four AI lanes analyse every significant decision in parallel. Pattern match. Risk assessment. Behavioural prediction. One question that cuts through the noise. 26 seconds.',
    color: '#0074D9',
  },
  {
    n: '03',
    title: 'PATTERN ENGINE',
    body: 'The system learns how you operate. Sleep-to-clarity correlations. Decision timing intelligence. Network decay detection. Patterns confirmed by data, never assumed.',
    color: '#34D399',
  },
  {
    n: '04',
    title: 'DEBRIEF ENGINE',
    body: 'Weekly performance review. What produced results. What limited them. One objective for the next cycle. Your 90-day operational record — built by your own data.',
    color: '#F1F5F9',
  },
];
---
<section class="section">
  <div class="section-head">
    <div class="eyebrow">HOW IT WORKS</div>
    <h2>Four engines. One system.<br /><strong>Your operational intelligence.</strong></h2>
  </div>
  <div class="engines">
    {engines.map((e) => (
      <div class="engine" style={`--accent:${e.color}`}>
        <div class="engine-num">{e.n}</div>
        <div class="engine-title">{e.title}</div>
        <div class="engine-body">{e.body}</div>
      </div>
    ))}
  </div>
</section>
