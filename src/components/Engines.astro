---
const engines = [
  {
    n: '01',
    title: 'BRIEF ENGINE',
    body: 'Your daily operational command brief. Readiness score, mode assignment, decision window, and three performance levers — delivered before you open your first email.',
    color: '#FFDC00',
  },
  {
    n: '02',
    title: 'DECISION ENGINE',
    body: 'Five AI lanes analyse your decision in parallel — Reasoner, Contrarian, Context Enhancer, Predictor, Pre-mortem — then synthesise into a single SENTINEL assessment. Each call ships with a failure-mode forecast and a calibration disclosure showing exactly what data the AI was given. In 26 seconds.',
    color: '#0074D9',
  },
  {
    n: '03',
    title: 'PATTERN ENGINE',
    body: 'Builds a model of your operational patterns over time. Only surfaces a pattern when the data supports it. Your readiness baseline becomes personal, not generic.',
    color: '#34D399',
  },
  {
    n: '04',
    title: 'DEBRIEF ENGINE',
    body: 'Weekly synthesis of decision quality, principle adherence, network health, and momentum. Sunday evening. Next week’s objective written to your Monday brief automatically.',
    color: '#F1F5F9',
  },
];
---
<section class="section">
  <div class="section-head">
    <div class="eyebrow">THE ARCHITECTURE</div>
    <h2>Four engines. <strong>One voice.</strong></h2>
    <p class="section-sub">Every morning brief, every decision assessment, every pattern insight is produced by a coordinated system — not a single AI guessing.</p>
  </div>
  <div class="engines">
    {engines.map((e) => (
      <div class="engine" style={`--accent:${e.color}`}>
        <div class="engine-num">{e.n}</div>
        <div class="engine-title">{e.title}</div>
        <div class="engine-body">{e.body}</div>
      </div>
    ))}
  </div>
</section>
