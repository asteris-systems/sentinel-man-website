---
const nodes = [
  { day: 'DAY 7', title: 'First Pattern', body: 'Your first confirmed operational pattern surfaces from the data.' },
  { day: 'DAY 14', title: 'Decision Advisor', body: 'The four-lane Decision Engine activates. Your first assessment.' },
  { day: 'DAY 21', title: 'The Provocation', body: 'One direct challenge from SENTINEL. Are you operating to your principles?' },
  { day: 'DAY 30', title: 'The Mirror', body: 'Your operating profile as the system has built it. No averages. Your data.' },
  { day: 'DAY 60', title: 'Baseline Established', body: 'Your personal baseline is live. Every score from here is comparative — not generic.' },
  { day: 'DAY 90', title: 'Identity Confirmed', body: 'One question. Ten seconds of silence. Then your answer.' },
];
---
<section class="section">
  <div class="section-head">
    <div class="eyebrow">THE TRANSFORMATION</div>
    <h2>90 days. <strong>Nine milestones.</strong></h2>
    <p class="section-sub">SENTINEL MAN was built around a designed transformation arc — not a feature list. Every milestone is earned from your data, not scheduled by the calendar.</p>
  </div>
  <div class="timeline">
    <div class="timeline-rail"></div>
    <div class="timeline-grid">
      {nodes.map((n) => (
        <div class="tl-node">
          <div class="tl-dot"><div class="tl-dot-inner"></div></div>
          <div class="tl-day">{n.day}</div>
          <div class="tl-title">{n.title}</div>
          <div class="tl-body">{n.body}</div>
        </div>
      ))}
    </div>
  </div>
</section>
