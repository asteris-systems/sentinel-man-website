---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/how-it-works', label: 'How it works' },
  { href: '/arc', label: 'The 90-day arc' },
  { href: '/about', label: 'About' },
  { href: '/#pricing', label: 'Pricing' },
];
const isActive = (l: { href: string }) => {
  if (l.href.startsWith('/#')) return false;
  return path === l.href || path.startsWith(l.href + '/');
};
---
<nav class="site-nav">
  <a href="/" aria-label="Sentinel Man home">
    <picture>
      <source srcset="/logo-200.webp" type="image/webp" />
      <img src="/logo-200.png" alt="Sentinel Man" class="nav-logo" width="72" height="72" />
    </picture>
  </a>
  <a href="/" class="nav-wordmark">SENTINEL MAN</a>
  <div class="nav-links">
    {links.map((l, i) => (
      <>
        {i > 0 && <span class="nav-sep">◆</span>}
        <a href={l.href} class={`nav-link${isActive(l) ? ' is-active' : ''}`}>{l.label}</a>
      </>
    ))}
    <span class="nav-sep">◆</span>
    <a href="/signin" class="nav-link">Sign in</a>
    <a href="/#pricing" class="nav-cta" data-track="cta_click" data-track-location="nav" data-track-label="Begin assessment">BEGIN ASSESSMENT</a>
  </div>
</nav>
