---
interface Props {
  eyebrow?: string;
  heading?: string;
  headingStrong?: string;
  sub?: string;
  cta?: string;
}
const {
  eyebrow,
  heading = 'Stop guessing.',
  headingStrong = 'Start operating.',
  sub = 'Eight days. No credit card. The system does the rest.',
  cta = 'Begin assessment →',
} = Astro.props;
---
<section class="final-cta">
  <div class="final-cta-inner">
    {eyebrow && <div class="eyebrow">{eyebrow}</div>}
    <h2>{heading}<br /><strong>{headingStrong}</strong></h2>
    <p>{sub}</p>
    <a href="/#pricing" class="cta-btn">{cta}</a>
  </div>
</section>
