---
const features = [
  'Daily operational brief',
  '4-lane Decision Advisor',
  'Pattern detection engine',
  'Operating Principles system',
  'Weekly debrief',
  '90-day transformation arc',
  'Network health tracking',
  'Carry-forward enforcement',
  'Milestone intelligence briefs',
  'Provocateur protocol',
  'iOS + Android + Web',
  'Personal data sovereignty',
];
---
<section id="pricing" class="section">
  <div class="section-head" style="margin-bottom:48px">
    <div class="eyebrow">PRICING</div>
    <h2 style="margin-bottom:12px">Full access. <strong>One tier.</strong></h2>
    <p class="section-sub">No feature gating. No growth tiers. Every engine available from day one.</p>
  </div>
  <div class="pricing-card">
    <div class="price-label">SENTINEL MAN</div>
    <div class="price-row">
      <span class="price-num">$19</span>
      <span class="price-per">.99/mo</span>
    </div>
    <div class="price-yearly">or $199/year — save 17%</div>
    <div class="price-rule"></div>
    <div class="price-feats">
      {features.map((f) => (
        <div class="feat">
          <span class="feat-check">✦</span>
          <span class="feat-text">{f}</span>
        </div>
      ))}
    </div>
    <a href="#" class="price-cta">Start your 7-day free trial →</a>
    <div class="price-note">No credit card required to begin.</div>
  </div>
</section>
