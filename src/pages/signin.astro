---
// /signin on the marketing site redirects to the real auth flow on
// the app subdomain. Sign-in does not happen on sentinelman.com —
// only on app.sentinelman.com (where Clerk is wired in).
//
// Astro static-build emits this as a meta-refresh redirect since
// there's no server runtime. Same end result for users.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=https://app.sentinelman.com/sign-in" />
    <link rel="canonical" href="https://app.sentinelman.com/sign-in" />
    <title>Redirecting…</title>
  </head>
  <body>
    <p>Redirecting to <a href="https://app.sentinelman.com/sign-in">app.sentinelman.com/sign-in</a>…</p>
    <script>window.location.replace('https://app.sentinelman.com/sign-in');</script>
  </body>
</html>
