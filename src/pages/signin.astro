---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Sign in — SENTINEL MAN" description="Sign in to your Sentinel Man account.">
  <div class="prose-wrap" style="text-align:center">
    <div class="prose-eyebrow">SIGN IN</div>
    <h1 class="prose-title">Authentication <strong>coming online.</strong></h1>
    <div class="prose-meta" style="display:inline-block;margin:0 auto 32px;border:1px solid var(--border);padding:14px 22px;border-radius:8px">
      <span>WEB APP LAUNCHING WITH iOS &amp; ANDROID</span>
    </div>
    <div class="prose">
      <p style="text-align:center">The Sentinel Man web app is launching alongside iOS and Android. Begin your 8-day trial below to be notified the moment it's live.</p>
      <p style="text-align:center;margin-top:32px"><a href="/#pricing" class="cta-btn" style="display:inline-flex">Begin your 8-day trial <span class="cta-arrow">→</span></a></p>
    </div>
  </div>
</BaseLayout>
